pragma solidity 0.8.27;

import {Script} from "forge-std/Script.sol";
import {console} from "forge-std/console.sol";

import {IC3DAppManager} from "@c3caller/dapp/IC3DAppManager.sol";

contract ProveNoContractFault is Script {
    address constant ADMIN = 0xccc435AaBc481D4Af9da51E51Eb2a383Bce6791F;
    address constant TARGET = 0x5aEEF48EDbd1A891E8F2410c88E35A92b37d003C;
    address constant PRANK_ACCOUNT = 0x858B2D17cfF5FF5cf0ce8d56D98555D1a5c6d8F1;
    address constant dappManager = 0xa06cF94381F4cE067CE6fd88C95a4e2eA6a29cDC;
    address constant feeToken = 0x70b52c6cDDA7C6b881DE77196EdFDF5a704b55f2;
    uint256 constant dappID = 26243786160252405427302909576549313777876500874080323496247859302443561356480;

    function run() public {
        vm.createSelectFork(vm.rpcUrl("linea-sepolia-rpc-url"));

        vm.txGasPrice(4 gwei);

        IC3DAppManager dappManager = IC3DAppManager(dappManager);

        uint256 dappStakePoolBefore = dappManager.dappStakePool(dappID, feeToken);

        vm.prank(PRANK_ACCOUNT);
        (bool success, bytes memory result) = TARGET.call(
            hex""
        );

        uint256 dappStakePoolAfter = dappManager.dappStakePool(dappID, feeToken);

        require(success, "Call reverted");

        console.log("Before:", dappStakePoolBefore);
        console.log("After:", dappStakePoolAfter);
    }
}
